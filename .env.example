# =====================================================================
# SPECZ.CO — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure real credentials for production.
# =====================================================================

# DATABASE & INFRASTRUCTURE
DATABASE_URL=postgresql://specz_user:super_secret_db_password@localhost:5432/specz_production_db
REDIS_URL=redis://localhost:6379/0

# AUTHENTICATION & SECURITY
JWT_SECRET=production_jwt_signing_key_change_me_in_prod_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# GOOGLE OAUTH (Web Client ID — for backend ID token verification)
GOOGLE_CLIENT_ID=your_production_google_web_client_id.apps.googleusercontent.com

# REAL AI & OCR GATEWAY
GEMINI_API_KEY=your_production_google_gemini_api_key
OPENAI_API_KEY=your_production_openai_api_key_for_vision_ocr

# PAYMENTS — RAZORPAY
RAZORPAY_KEY_ID=rzp_live_your_production_key_id
RAZORPAY_KEY_SECRET=your_production_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_production_webhook_secret_for_signature_verification

# OBJECT STORAGE (AWS S3 / CLOUDFLARE R2)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_BUCKET_NAME=specz-production-reports-and-scans
STORAGE_ACCESS_KEY=your_production_storage_access_key
STORAGE_SECRET_KEY=your_production_storage_secret_key

# EMAIL (RESEND)
RESEND_API_KEY=re_your_production_resend_email_api_key

# MONITORING & OBSERVABILITY
SENTRY_DSN=https://your_sentry_dsn_key@o0.ingest.sentry.io/0
ENVIRONMENT=production
