# Specz.co V2 — Backend Environment Configuration Example

# Environment Mode: development, staging, production
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="Specz.co V2 API"

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://specz_user:specz_password@localhost:5432/specz_db
SYNC_DATABASE_URL=postgresql://specz_user:specz_password@localhost:5432/specz_db

# Security & Authentication Secrets
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION_32_BYTES
REFRESH_TOKEN_SECRET=CHANGE_THIS_TO_ANOTHER_SECURE_RANDOM_SECRET_KEY_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth (Web Client ID — used for backend token verification)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Payment Integration (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# AI & OCR Provider API Keys (Isolated strictly on server)
AI_API_KEY=placeholder_gemini_vision_api_key

# S3 Private Object Storage Configuration
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_BUCKET=specz-medical-storage
S3_ACCESS_KEY=placeholder_s3_access_key
S3_SECRET_KEY=placeholder_s3_secret_key
S3_REGION=us-east-1

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# Security & CORS Origins
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","https://staging-api.specz.co","https://api.specz.co"]
